# Database
DB_PATH=./data/apex.db

# Server
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Cashflows Payment
CASHFLOWS_API_KEY=your-cashflows-api-key
CASHFLOWS_MERCHANT_ID=your-merchant-id

# Email Configuration
EMAIL_HOST=smtp.mail.ovh.net
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-password
EMAIL_FROM=support@apexingoodcompany.co.uk

# Session
SESSION_SECRET=apex-moto-secret-key

# Admin Settings
ADMIN_EMAIL=admin@apexmotocompetitions.com
ADMIN_PASSWORD=admin123

# Workshop / Android API authentication
WORKSHOP_AUTH_SECRET=replace-with-a-random-64-character-secret
WORKSHOP_EMAIL=workshop@example.com
WORKSHOP_PASSWORD=change-this-password
WORKSHOP_USERNAME=workshop
WORKSHOP_DISPLAY_NAME=Workshop User
WORKSHOP_ROLE=detailer
