<%-include('partials/header')%>

<div class="container" style="max-width: 400px; margin: 50px auto;">
    <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; padding: 40px; text-align: center;">
        <h1 style="margin-top: 0; color: var(--primary); font-size: 1.8em; margin-bottom: 10px;">🔐 Forgot Password?</h1>
        <p style="color: var(--text-muted); margin-bottom: 30px;">Enter your email and we'll send you a reset link.</p>

        <% if (error) { %>
            <div style="background: #ef4444; color: white; padding: 12px; border-radius: 4px; margin-bottom: 20px; font-size: 0.9em;">
                <%= error %>
            </div>
        <% } %>

        <% if (message) { %>
            <div style="background: #10b981; color: white; padding: 12px; border-radius: 4px; margin-bottom: 20px; font-size: 0.9em;">
                <%= message %>
            </div>
        <% } %>

        <form method="POST" style="text-align: left;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div style="margin-bottom: 20px;">
                <label style="display: block; color: var(--text-main); font-weight: 600; margin-bottom: 8px;">Email Address</label>
                <input type="email" name="email" required placeholder="you@example.com" style="width: 100%; padding: 12px; background: rgba(255,255,255,0.05); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-main); font-size: 1em; box-sizing: border-box;">
            </div>

            <button type="submit" style="width: 100%; padding: 12px; background: linear-gradient(135deg, #ff5500, #ff7722); color: white; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 1em; text-transform: uppercase; letter-spacing: 1px;">Send Reset Link</button>
        </form>

        <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--border-color);">
            <p style="color: var(--text-muted); font-size: 0.9em;">
                Remember your password? <a href="/login" style="color: var(--primary); text-decoration: none; font-weight: 600;">Back to Login</a>
            </p>
        </div>
    </div>
</div>

<%-include('partials/footer')%>
