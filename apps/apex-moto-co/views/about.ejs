<%- include('./partials/header') %>

<main>
    <!-- Hero Section -->
    <section style="background: linear-gradient(135deg, #1a0a00 0%, #000000 100%); border-bottom: 1px solid #ff5500; padding: 80px 20px; text-align: center; color: #fff;">
        <div class="container">
            <h1 style="font-size: 3em; font-weight: 900; text-transform: uppercase; letter-spacing: 2px; margin: 0; text-shadow: 0 0 10px rgba(255,85,0,0.4);">About Apex Moto & Co</h1>
            <p style="font-size: 1.3rem; color: #ff5500; margin-top: 15px; font-weight: 600; letter-spacing: 1px;">The Ultimate Motorcycle Lifestyle Hub</p>
        </div>
    </section>

    <!-- Main Content -->
    <section class="py-5">
        <div class="container" style="max-width: 900px;">
            <!-- Our Story -->
            <div style="background: var(--bg-card); border: 1px solid #ff5500; border-radius: 8px; padding: 40px; margin-bottom: 40px;">
                <h2 style="color: #ff5500; text-transform: uppercase; letter-spacing: 1px; margin-top: 0; border-bottom: 2px solid #ff5500; padding-bottom: 15px;">Our Story</h2>
                <p style="color: var(--text-muted); font-size: 1.1rem; line-height: 1.8; margin-top: 20px;">
                    Welcome to <strong style="color: #fff;">Apex Moto & Co.</strong> – a thriving community of motorcycle enthusiasts united by passion, authenticity, and the love of the ride. What started as a tight-knit group of friends sharing a genuine passion for two wheels has evolved into something much greater.
                </p>
                <p style="color: var(--text-muted); font-size: 1.1rem; line-height: 1.8;">
                    Our journey began on the road with <strong style="color: #fff;">Apex Moto Events</strong>, hosting local bike meets, track days, and ride-outs across the UK. As our community grew, so did our vision. We expanded to launch <strong style="color: #fff;">Apex Moto Detailing</strong>, providing our community with premium vehicle care and protection services.
                </p>
            </div>

            <!-- Who We Are -->
            <div style="background: var(--bg-card); border: 1px solid #ff5500; border-radius: 8px; padding: 40px; margin-bottom: 40px;">
                <h2 style="color: #ff5500; text-transform: uppercase; letter-spacing: 1px; margin-top: 0; border-bottom: 2px solid #ff5500; padding-bottom: 15px;">Who We Are</h2>
                <p style="color: var(--text-muted); font-size: 1.1rem; line-height: 1.8; margin-top: 20px;">
                    We are a collective of passionate enthusiasts dedicated to creating an authentic lifestyle hub for motorcycle riders and automotive lovers. Each venture under the Apex Moto & Co. umbrella operates as a separate company, yet all are driven by a shared commitment to excellence and community.
                </p>
                <p style="color: var(--text-muted); font-size: 1.1rem; line-height: 1.8;">
                    Our core values include:
                </p>
                <ul style="color: var(--text-muted); font-size: 1.1rem; line-height: 1.8; margin-left: 20px;">
                    <li><strong style="color: #fff;">Authenticity:</strong> We're genuine enthusiasts, not just business operators</li>
                    <li><strong style="color: #fff;">Transparency:</strong> We operate with complete honesty and integrity</li>
                    <li><strong style="color: #fff;">Excellence:</strong> We pursue quality in everything we do</li>
                    <li><strong style="color: #fff;">Community:</strong> We prioritize real connections and support for our members</li>
                    <li><strong style="color: #fff;">Innovation:</strong> We constantly push boundaries and explore new opportunities</li>
                </ul>
            </div>

            <!-- Our Vision -->
            <div style="background: var(--bg-card); border: 1px solid #ff5500; border-radius: 8px; padding: 40px; margin-bottom: 40px;">
                <h2 style="color: #ff5500; text-transform: uppercase; letter-spacing: 1px; margin-top: 0; border-bottom: 2px solid #ff5500; padding-bottom: 15px;">Our Vision</h2>
                <p style="color: var(--text-muted); font-size: 1.1rem; line-height: 1.8; margin-top: 20px;">
                    We are constantly pushing the redline. Our goal is to become the ultimate lifestyle hub for enthusiasts – a one-stop destination for everything motorcycle and automotive culture. We're expanding into new areas including premium apparel, vehicle sales, and professional servicing.
                </p>
                <p style="color: var(--text-muted); font-size: 1.1rem; line-height: 1.8;">
                    Fully transparent, highly meticulous, and driven by real connections. This is the Apex family – where passion meets professionalism, and community comes first.
                </p>
            </div>

            <!-- What We Offer -->
            <div style="background: var(--bg-card); border: 1px solid #ff5500; border-radius: 8px; padding: 40px;">
                <h2 style="color: #ff5500; text-transform: uppercase; letter-spacing: 1px; margin-top: 0; border-bottom: 2px solid #ff5500; padding-bottom: 15px;">What We Offer</h2>
                
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-top: 30px;">
                    <div>
                        <h3 style="color: #ff5500; margin-top: 0;">🏪 Store</h3>
                        <p style="color: var(--text-muted); line-height: 1.6;">Premium motorcycle gear, apparel, and accessories curated by enthusiasts for enthusiasts.</p>
                    </div>
                    <div>
                        <h3 style="color: #ff5500; margin-top: 0;">✨ Detailing</h3>
                        <p style="color: var(--text-muted); line-height: 1.6;">Professional vehicle detailing services with ceramic coatings and premium protection.</p>
                    </div>
                    <div>
                        <h3 style="color: #ff5500; margin-top: 0;">🎉 Events</h3>
                        <p style="color: var(--text-muted); line-height: 1.6;">Community bike meets, track days, ride-outs, and exclusive member events.</p>
                    </div>
                    <div>
                        <h3 style="color: #ff5500; margin-top: 0;">👥 Community</h3>
                        <p style="color: var(--text-muted); line-height: 1.6;">Connect with fellow enthusiasts, share experiences, and be part of something larger.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Call to Action -->
    <section style="background: var(--bg-card); padding: 60px 20px; text-align: center; border-top: 1px solid #ff5500;">
        <div class="container">
            <h2 style="color: #ff5500; text-transform: uppercase; letter-spacing: 1px; margin-top: 0;">Join the Apex Family</h2>
            <p style="color: var(--text-muted); font-size: 1.1rem; max-width: 600px; margin: 20px auto;">
                Whether you're here for gear, services, events, or community – there's a place for you at Apex Moto & Co.
            </p>
            <div style="display: flex; gap: 20px; justify-content: center; flex-wrap: wrap; margin-top: 30px;">
                <a href="/store" style="background-color: #ff5500; color: #fff; padding: 12px 30px; border-radius: 8px; text-decoration: none; font-weight: bold; display: inline-block;">Visit Store</a>
                <a href="/detailing" style="background-color: transparent; color: #ff5500; padding: 12px 30px; border-radius: 8px; text-decoration: none; font-weight: bold; display: inline-block; border: 2px solid #ff5500;">Detailing Services</a>
                <a href="/contact" style="background-color: transparent; color: #ff5500; padding: 12px 30px; border-radius: 8px; text-decoration: none; font-weight: bold; display: inline-block; border: 2px solid #ff5500;">Get In Touch</a>
            </div>
        </div>
    </section>
</main>

<%- include('./partials/footer') %>
