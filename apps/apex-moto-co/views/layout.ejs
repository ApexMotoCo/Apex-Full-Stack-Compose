<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ApexMoto&Co</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/mobile-fixes.css">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">🏍️ ApexMoto&Co</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="/competitions/live">Live Competitions</a></li>
                    <li class="nav-item"><a class="nav-link" href="/competitions/past">Past Competitions</a></li>
                    <li class="nav-item"><a class="nav-link" href="/winners">Past Winners</a></li>
                    <li class="nav-item"><a class="nav-link" href="/store">Store</a></li>
                    <li class="nav-item"><a class="nav-link" href="/contact">Contact</a></li>
                    <li class="nav-item"><a class="nav-link" href="/privacy">Privacy</a></li>
                    <li class="nav-item"><a class="nav-link" href="/terms">Terms</a></li>
                    <% if (user) { %>
                        <li class="nav-item"><a class="nav-link" href="/dashboard">Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link" href="/logout">Logout (<%= user.name %>)</a></li>
                    <% } else { %>
                        <li class="nav-item"><a class="nav-link" href="/login">Login</a></li>
                        <li class="nav-item"><a class="nav-link" href="/register">Register</a></li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <main>
        <%- body %>
    </main>

    <footer class="bg-dark text-white text-center py-4 mt-5">
        <div class="container">
            <p>&copy; 2024 ApexMoto&Co. All rights reserved.</p>
            <p style="font-size: 12px;">
                <a href="/privacy" style="color: #ff8c00; text-decoration: none;">Privacy Policy</a> | 
                <a href="/terms" style="color: #ff8c00; text-decoration: none;">Terms & Conditions</a> | 
                <a href="/contact" style="color: #ff8c00; text-decoration: none;">Contact</a>
            </p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
