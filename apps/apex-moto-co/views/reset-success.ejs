<%-include('partials/header')%>

<div class="container" style="max-width: 400px; margin: 50px auto;">
    <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; padding: 40px; text-align: center;">
        <div style="font-size: 3em; margin-bottom: 20px;">✅</div>
        <h1 style="margin-top: 0; color: #10b981; font-size: 1.8em; margin-bottom: 10px;">Password Reset</h1>
        <p style="color: var(--text-muted); margin-bottom: 30px;">Your password has been reset successfully!</p>

        <div style="background: rgba(16,185,129,0.1); border: 1px solid #10b981; padding: 20px; border-radius: 4px; margin-bottom: 30px;">
            <p style="color: var(--text-main); margin: 0;">You can now log in with your new password.</p>
        </div>

        <a href="/login" style="display: inline-block; padding: 12px 30px; background: linear-gradient(135deg, #ff5500, #ff7722); color: white; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 1em; text-transform: uppercase; letter-spacing: 1px; text-decoration: none;">Go to Login</a>
    </div>
</div>

<%-include('partials/footer')%>
