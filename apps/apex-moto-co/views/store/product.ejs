<%- include('../partials/header') %>

<main class="py-5">
    <div class="container">
        <a href="/store" style="color: #ff5500; text-decoration: none; margin-bottom: 30px; display: inline-block;">← Back to Store</a>

        <% if (product) { %>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start;">
                <!-- Images -->
                <div>
                    <% const images = product.images && product.images.edges ? product.images.edges : []; %>
                    <% if (images.length > 0) { %>
                        <div style="width: 100%; background: #000; border-radius: 8px; overflow: hidden; margin-bottom: 20px;">
                            <img id="mainImage" src="<%= images[0].node.src %>" alt="<%= images[0].node.altText || product.title %>" style="width: 100%; display: block;">
                        </div>
                        <% if (images.length > 1) { %>
                            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px;">
                                <% images.forEach((img, idx) => { %>
                                    <img src="<%= img.node.src %>" alt="<%= img.node.altText || product.title %>" 
                                         style="width: 100%; cursor: pointer; border: 2px solid <%= idx === 0 ? '#ff5500' : '#333' %>; border-radius: 4px; padding: 5px; box-sizing: border-box;"
                                         onclick="document.getElementById('mainImage').src = this.src; document.querySelectorAll('[data-thumb]').forEach(t => t.style.borderColor = '#333'); this.style.borderColor = '#ff5500';">
                                <% }); %>
                            </div>
                        <% } %>
                    <% } else { %>
                        <div style="width: 100%; height: 400px; background: linear-gradient(135deg, #ff5500 0%, #e64900 100%); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                            <span style="color: #fff; font-size: 5rem;">📦</span>
                        </div>
                    <% } %>
                </div>

                <!-- Details -->
                <div>
                    <h1 style="color: #ff5500; margin: 0 0 10px 0;"><%= product.title %></h1>
                    
                    <% if (product.vendor) { %>
                        <p style="color: var(--text-muted); font-size: 1rem; margin: 0 0 20px 0;"><strong>Brand:</strong> <%= product.vendor %></p>
                    <% } %>

                    <% if (product.productType) { %>
                        <p style="color: var(--text-muted); font-size: 0.95rem; margin: 0 0 20px 0;"><strong>Category:</strong> <%= product.productType %></p>
                    <% } %>

                    <!-- Variants/Pricing -->
                    <% const variants = product.variants && product.variants.edges ? product.variants.edges : []; %>
                    <% if (variants.length > 0) { %>
                        <div style="background: var(--bg-card); border: 1px solid #333; padding: 20px; border-radius: 8px; margin: 30px 0;">
                            <% const firstVariant = variants[0].node; %>
                            <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0 0 10px 0;">Price</p>
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <h2 style="color: #ff5500; margin: 0; font-size: 2rem;">£<%= firstVariant.price %></h2>
                                <% if (firstVariant.compareAtPrice && firstVariant.compareAtPrice !== firstVariant.price) { %>
                                    <p style="color: var(--text-muted); text-decoration: line-through; margin: 0;">£<%= firstVariant.compareAtPrice %></p>
                                <% } %>
                            </div>
                            <p style="color: <%= firstVariant.availableForSale ? '#10b981' : '#ef4444' %>; font-weight: bold; margin: 15px 0 0 0;">
                                <%= firstVariant.availableForSale ? '✓ In Stock' : '✗ Out of Stock' %>
                            </p>
                        </div>

                        <% if (variants.length > 1) { %>
                            <div style="margin: 30px 0;">
                                <label style="color: #ff5500; font-weight: bold; display: block; margin-bottom: 10px;">Options</label>
                                <select id="variantSelect" style="width: 100%; padding: 12px; background-color: var(--bg-card); color: #fff; border: 1px solid #ff5500; border-radius: 4px;">
                                    <% variants.forEach((variant, idx) => { %>
                                        <option value="<%= idx %>" data-price="<%= variant.node.price %>" data-available="<%= variant.node.availableForSale %>">
                                            <%= variant.node.title %> - £<%= variant.node.price %>
                                        </option>
                                    <% }); %>
                                </select>
                            </div>
                        <% } %>
                    <% } %>

                    <!-- Description -->
                    <% if (product.description) { %>
                        <div style="margin: 30px 0;">
                            <h3 style="color: #ff5500; margin: 0 0 15px 0;">Description</h3>
                            <div style="color: var(--text-muted); line-height: 1.8; white-space: pre-wrap;"><%- product.description %></div>
                        </div>
                    <% } %>

                    <!-- Shopify Link -->
                    <div style="margin-top: 40px;">
                        <a href="https://apexapparelsupply.myshopify.com/products/<%= product.handle %>" target="_blank" rel="noopener noreferrer" 
                           style="display: inline-block; background-color: #ff5500; color: #fff; padding: 15px 40px; border-radius: 8px; text-decoration: none; font-weight: bold; font-size: 1.1rem;">
                            View & Purchase on Shopify
                        </a>
                    </div>
                </div>
            </div>
        <% } else { %>
            <div style="text-align: center; padding: 60px 20px;">
                <p style="color: var(--text-muted); font-size: 1.2rem;">Product not found.</p>
                <a href="/store" style="color: #ff5500; text-decoration: none; margin-top: 20px; display: inline-block;">← Back to Store</a>
            </div>
        <% } %>
    </div>
</main>

<%- include('../partials/footer') %>
