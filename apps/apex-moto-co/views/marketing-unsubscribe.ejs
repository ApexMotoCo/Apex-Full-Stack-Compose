<%- include('./partials/header') %>

<main class="container marketing-unsubscribe-page">
    <section class="admin-panel">
        <% if (success) { %>
            <h1>Email preferences updated</h1>
            <p>You have been unsubscribed from Apex Moto & Co marketing emails.</p>
        <% } else if (invalid) { %>
            <h1>Link unavailable</h1>
            <p>This unsubscribe link is invalid or has already been used.</p>
        <% } else { %>
            <h1>Unsubscribe from marketing emails?</h1>
            <p>Confirm below to stop receiving Apex Moto & Co marketing emails.</p>
            <form method="POST" action="/unsubscribe/<%= encodeURIComponent(token) %>">
                <button type="submit" class="btn btn-primary">Confirm unsubscribe</button>
            </form>
        <% } %>
        <p><a href="/">Return to Apex Moto & Co</a></p>
    </section>
</main>

<%- include('./partials/footer') %>
