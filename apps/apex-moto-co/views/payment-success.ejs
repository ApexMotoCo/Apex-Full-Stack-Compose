<%- include('./partials/header') %>

<div class="container">
    <div style="max-width: 600px; margin: 60px auto; text-align: center;">
        
        <!-- Success Icon -->
        <div style="font-size: 80px; margin-bottom: 20px; animation: bounce 1s ease-in-out;">✓</div>

        <!-- Success Message -->
        <h1 style="color: #10b981; text-transform: uppercase; letter-spacing: 2px; margin: 0 0 15px 0; font-size: 2em;">Payment Successful!</h1>

        <p style="color: var(--text-muted); font-size: 1.1em; margin-bottom: 40px;">
            Thank you for your order. Your payment has been processed successfully.
        </p>

        <!-- Success Card -->
        <div style="background: rgba(16, 185, 129, 0.1); border: 2px solid #10b981; border-radius: 8px; padding: 30px; margin-bottom: 40px;">
            
            <div style="text-align: left;">
                <div style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid var(--border-color);">
                    <span style="color: var(--text-muted);">Transaction Status:</span>
                    <span style="color: #10b981; font-weight: bold;">✓ Completed</span>
                </div>
                
                <div style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid var(--border-color);">
                    <span style="color: var(--text-muted);">Order Type:</span>
                    <span style="color: var(--text-main); font-weight: bold;">Store Purchase</span>
                </div>

                <div style="display: flex; justify-content: space-between; padding: 12px 0; border-bottom: 1px solid var(--border-color);">
                    <span style="color: var(--text-muted);">Payment Method:</span>
                    <span style="color: var(--text-main); font-weight: bold;">Cashflows Gateway</span>
                </div>

                <div style="display: flex; justify-content: space-between; padding: 12px 0;">
                    <span style="color: var(--text-muted);">Date & Time:</span>
                    <span style="color: var(--text-main); font-weight: bold;"><%= new Date().toLocaleString() %></span>
                </div>
            </div>

        </div>

        <!-- Next Steps -->
        <div style="background: var(--bg-card); border: 2px solid #ff5500; border-radius: 8px; padding: 25px; margin-bottom: 40px; text-align: left;">
            
            <h2 style="color: #ff5500; text-transform: uppercase; font-size: 1.1em; margin-top: 0;">What's Next?</h2>
            
            <ol style="color: var(--text-muted); line-height: 1.8; margin: 0; padding-left: 20px;">
                <li>You will receive an order confirmation email shortly</li>
                <li>Track your order in your <a href="/dashboard" style="color: #ff5500; text-decoration: none; font-weight: bold;">Dashboard</a></li>
                <li>Your items will be dispatched within 2-3 business days</li>
                <li>You will receive tracking information via email</li>
            </ol>

        </div>

        <!-- Action Buttons -->
        <div style="display: flex; gap: 15px; justify-content: center; flex-wrap: wrap;">
            <a href="/store" class="btn btn-primary" style="text-decoration: none; padding: 12px 30px; text-transform: uppercase; font-weight: bold;">
                🛍️ Continue Shopping
            </a>
            <a href="/dashboard" class="btn btn-primary" style="text-decoration: none; padding: 12px 30px; text-transform: uppercase; font-weight: bold; background: transparent; border: 2px solid #ff5500; color: #ff5500;">
                📦 View Orders
            </a>
        </div>

        <!-- Support Info -->
        <div style="margin-top: 50px; padding-top: 20px; border-top: 1px solid var(--border-color); color: var(--text-muted); font-size: 0.9em;">
            <p style="margin: 0 0 10px 0;">Have questions about your order?</p>
            <a href="/contact" style="color: #ff5500; text-decoration: none; font-weight: bold;">Contact our support team →</a>
        </div>

    </div>
</div>

<style>
    @keyframes bounce {
        0%, 100% { transform: translateY(0); color: #10b981; }
        50% { transform: translateY(-20px); color: #34d399; }
    }
</style>

<%- include('./partials/footer') %>
