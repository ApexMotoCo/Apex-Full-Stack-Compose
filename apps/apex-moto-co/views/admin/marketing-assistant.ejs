<%- include('../partials/header') %>

<link rel="stylesheet" href="/css/marketing-assistant.css">
<main class="container marketing-assistant" data-marketing-assistant data-csrf-token="<%= csrfToken %>">
    <div class="marketing-assistant-heading">
        <div>
            <p class="marketing-assistant-eyebrow">APEX MOTO & CO · ADMIN TOOLS</p>
            <h1>Marketing copilot</h1>
            <p>Turn a clear brief into campaign ideas and ready-to-edit marketing copy. Social posts remain drafts until their accounts are connected.</p>
        </div>
        <a href="/admin" class="btn btn-warning">← Admin dashboard</a>
    </div>

    <div class="marketing-assistant-grid">
        <form class="admin-panel marketing-assistant-form" data-marketing-form>
            <h2>Build your brief</h2>
            <label for="marketing-type">What are you creating?</label>
            <select id="marketing-type" name="campaignType" required>
                <option value="campaign">Campaign strategy</option>
                <option value="social">Social media posts</option>
                <option value="email">Marketing email</option>
                <option value="promotion">Promotion concept</option>
                <option value="product-copy">Product or service copy</option>
                <option value="content-calendar">Four-week content calendar</option>
            </select>

            <label for="marketing-audience">Who is it for?</label>
            <input id="marketing-audience" name="audience" maxlength="200" placeholder="e.g. UK motorcycle commuters">

            <label for="marketing-objective">What should it achieve?</label>
            <input id="marketing-objective" name="objective" maxlength="300" placeholder="e.g. Generate detailing enquiries">

            <label for="marketing-tone">Writing tone</label>
            <select id="marketing-tone" name="tone" required>
                <option>Energetic</option>
                <option>Premium</option>
                <option>Friendly</option>
                <option>Informative</option>
            </select>

            <label for="marketing-details">Brief, channel or confirmed facts</label>
            <textarea id="marketing-details" name="details" maxlength="2000" rows="6" placeholder="Add the channel, product or service details, dates, offer terms, and anything else the copy must include. Mark facts you haven't confirmed as unknown."></textarea>
            <p class="marketing-assistant-note">Drafts are suggestions. Check prices, availability, dates and claims before publishing.</p>
            <button type="submit" class="btn btn-primary" data-marketing-submit>Generate marketing draft</button>
            <p class="marketing-assistant-status" data-marketing-status role="status" aria-live="polite"></p>
        </form>

        <section class="admin-panel marketing-assistant-output" aria-labelledby="marketing-output-title">
            <div class="marketing-assistant-output-heading">
                <div>
                    <p class="marketing-assistant-eyebrow">YOUR NEXT IDEA</p>
                    <h2 id="marketing-output-title">Draft workspace</h2>
                </div>
                <button type="button" class="btn btn-warning" data-marketing-copy disabled>Copy draft</button>
                <button type="button" class="btn btn-primary" data-marketing-use-email disabled>Use in email</button>
            </div>
            <pre data-marketing-draft aria-live="polite">Your marketing draft will appear here. Start with a campaign idea, a service to promote or a social post brief.</pre>
        </section>
    </div>

    <section class="admin-panel marketing-campaign-composer" aria-labelledby="marketing-campaign-title">
        <div class="marketing-assistant-output-heading">
            <div>
                <p class="marketing-assistant-eyebrow">OPTED-IN SUBSCRIBERS ONLY</p>
                <h2 id="marketing-campaign-title">Email campaign</h2>
            </div>
            <a class="btn btn-warning" href="/admin/marketing-campaigns">Campaign history</a>
        </div>
        <p class="marketing-assistant-note">
            Current audience: <strong><%= recipientCount %></strong> opted-in account holders.
            New registrations are not subscribed unless they select the optional consent checkbox.
            Every email includes an unsubscribe link.
        </p>
        <form id="marketing-campaign-form" data-marketing-campaign-form data-csrf-token="<%= csrfToken %>">
            <label for="campaign-name">Internal campaign name</label>
            <input id="campaign-name" name="name" maxlength="120" required placeholder="e.g. Winter detailing launch">

            <label for="campaign-subject">Email subject</label>
            <input id="campaign-subject" name="subject" maxlength="200" required placeholder="A clear subject line">

            <label for="campaign-body">Email content</label>
            <textarea id="campaign-body" name="body" maxlength="20000" rows="10" required placeholder="Paste or adapt your reviewed marketing draft here."></textarea>

            <label for="campaign-schedule">Schedule send (optional)</label>
            <input id="campaign-schedule" name="scheduledAt" type="datetime-local">
            <p class="marketing-assistant-note">Saving a draft does not send it. Scheduling approves the message for automatic delivery at the selected time. Send-now campaigns require a separate confirmation.</p>

            <div class="marketing-campaign-actions">
                <button class="btn btn-warning" name="action" value="draft" type="submit">Save draft</button>
                <button class="btn btn-primary" name="action" value="schedule" type="submit">Schedule campaign</button>
            </div>
            <p class="marketing-assistant-status" data-marketing-campaign-status role="status" aria-live="polite"></p>
        </form>
    </section>
</main>
<script src="/js/marketing-assistant.js"></script>
<script src="/js/marketing-campaigns.js"></script>

<%- include('../partials/footer') %>
