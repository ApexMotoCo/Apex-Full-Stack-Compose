<%- include('../header') %>

<div class="container-fluid mt-4 mb-5">
  <div class="row">
    <div class="col-lg-12">
      <h1 class="mb-4" style="color: #ff8c00;">📊 Analytics & Reports</h1>

      <div class="row mb-4">
        <div class="col-md-6">
          <div class="card" style="border-top: 3px solid #ff8c00;">
            <div class="card-body">
              <h5 class="card-title">💰 Total Revenue</h5>
              <h2 style="color: #ff8c00;">£<%= (stats.total_revenue || 0).toFixed(2) %></h2>
              <p class="text-muted">From completed orders</p>
            </div>
          </div>
        </div>

        <div class="col-md-6">
          <div class="card" style="border-top: 3px solid #ff8c00;">
            <div class="card-body">
              <h5 class="card-title">✅ Completed Orders</h5>
              <h2 style="color: #ff8c00;"><%= stats.completed_orders || 0 %></h2>
              <p class="text-muted">Successful transactions</p>
            </div>
          </div>
        </div>
      </div>

      <div class="row mb-4">
        <div class="col-md-4">
          <div class="card">
            <div class="card-body">
              <h5 class="card-title">🏆 Total Entries</h5>
              <h2 style="color: #ff8c00;"><%= stats.total_entries || 0 %></h2>
              <p class="text-muted">Competition participations</p>
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card">
            <div class="card-body">
              <h5 class="card-title">👥 Total Users</h5>
              <h2 style="color: #ff8c00;"><%= stats.total_users || 0 %></h2>
              <p class="text-muted">Registered accounts</p>
            </div>
          </div>
        </div>

        <div class="col-md-4">
          <div class="card">
            <div class="card-body">
              <h5 class="card-title">🛍️ Store Items</h5>
              <h2 style="color: #ff8c00;"><%= stats.total_items || 0 %></h2>
              <p class="text-muted">Products available</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Export Section -->
      <div class="card">
        <div class="card-header" style="background-color: #ff8c00; color: white;">
          <h5 class="mb-0">📥 Data Exports</h5>
        </div>
        <div class="card-body">
          <p class="text-muted mb-3">Export your data for analysis and reporting:</p>
          <div class="row">
            <div class="col-md-4 mb-3">
              <a href="/admin/export/competitions/csv" class="btn btn-outline-primary btn-block" style="border-color: #ff8c00; color: #ff8c00;">
                📋 Export Competitions (CSV)
              </a>
            </div>
            <div class="col-md-4 mb-3">
              <a href="/admin/export/orders/csv" class="btn btn-outline-primary btn-block" style="border-color: #ff8c00; color: #ff8c00;">
                📊 Export Orders (CSV)
              </a>
            </div>
            <div class="col-md-4 mb-3">
              <a href="/admin/export/users/csv" class="btn btn-outline-primary btn-block" style="border-color: #ff8c00; color: #ff8c00;">
                👥 Export Users (CSV)
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('../footer') %>
