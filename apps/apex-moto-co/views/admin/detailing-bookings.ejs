<%- include('../partials/header') %>

<main class="py-5">
    <div class="container">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
            <h1 style="color: #ff5500; margin: 0;">Detailing Bookings</h1>
            <a href="/admin/detailing/bookings/export" style="background-color: #10b981; color: #fff; padding: 10px 20px; border-radius: 8px; text-decoration: none; font-weight: bold; font-size: 0.9em; margin-right: 10px;">📥 Export CSV</a>
            <a href="/admin" style="background-color: #ff5500; color: #fff; padding: 10px 20px; border-radius: 8px; text-decoration: none; font-weight: bold;">← Back to Admin</a>
        </div>

        <% if (bookings && bookings.length > 0) { %>
            <div style="background: var(--bg-card); border: 1px solid #333; border-radius: 8px; overflow: hidden;">
                <table style="width: 100%; border-collapse: collapse;">
                    <thead style="background-color: #1a1a1a;">
                        <tr>
                            <th style="padding: 15px; text-align: left; color: #ff5500; font-weight: bold; border-bottom: 2px solid #ff5500;">Name</th>
                            <th style="padding: 15px; text-align: left; color: #ff5500; font-weight: bold; border-bottom: 2px solid #ff5500;">Phone</th>
                            <th style="padding: 15px; text-align: left; color: #ff5500; font-weight: bold; border-bottom: 2px solid #ff5500;">Vehicle</th>
                            <th style="padding: 15px; text-align: left; color: #ff5500; font-weight: bold; border-bottom: 2px solid #ff5500;">Service</th>
                            <th style="padding: 15px; text-align: left; color: #ff5500; font-weight: bold; border-bottom: 2px solid #ff5500;">Status</th>
                            <th style="padding: 15px; text-align: left; color: #ff5500; font-weight: bold; border-bottom: 2px solid #ff5500;">Appointment</th>
                            <th style="padding: 15px; text-align: left; color: #ff5500; font-weight: bold; border-bottom: 2px solid #ff5500;">Notes</th>
                            <th style="padding: 15px; text-align: left; color: #ff5500; font-weight: bold; border-bottom: 2px solid #ff5500;">Photos</th>
                            <th style="padding: 15px; text-align: left; color: #ff5500; font-weight: bold; border-bottom: 2px solid #ff5500;">Booking</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% bookings.forEach(booking => { %>
                            <tr style="border-bottom: 1px solid #333;">
                                <td style="padding: 15px; color: var(--text-muted);"><%= booking.name || 'N/A' %><br><span><%= booking.email || '' %></span></td>
                                <td style="padding: 15px; color: var(--text-muted);"><%= booking.phone || 'N/A' %></td>
                                <td style="padding: 15px; color: var(--text-muted);"><%= booking.vehicle_type || 'N/A' %></td>
                                <td style="padding: 15px; color: var(--text-muted);" title="<%= booking.service_type || 'Service not specified' %>"><%= booking.service_type || 'Service not specified' %></td>
                                <td style="padding: 15px;">
                                    <% const status = booking.status || 'pending'; %>
                                    <span style="background-color: <%= status === 'pending' ? '#ff5500' : status === 'completed' ? '#10b981' : '#526171' %>; color: #fff; padding: 5px 10px; border-radius: 4px; font-weight: bold; font-size: 0.85em;"><%= status.replace(/_/g, ' ') %></span>
                                </td>
                                <td style="padding: 15px; color: var(--text-muted);"><%= booking.booking_date || 'N/A' %><% if (booking.booking_time) { %><br><%= booking.booking_time %><% } %></td>
                                <td style="padding: 15px; color: var(--text-muted); white-space: pre-line;"><%= booking.notes || '—' %></td>
                                <td style="padding: 15px; color: var(--text-muted);">
                                    <% const bookingPhotos = photosByBooking[booking.id] || []; %>
                                    <% bookingPhotos.forEach((photo, index) => { %>
                                        <a href="/uploads/detailing-jobs/<%= encodeURIComponent(photo.filename) %>" target="_blank" rel="noopener noreferrer" style="color: #ff986f;"><%= photo.original_name || `Photo ${index + 1}` %></a><% if (index < bookingPhotos.length - 1) { %><br><% } %>
                                    <% }); %>
                                </td>
                                <td style="padding: 15px;">
                                    <a href="/admin/detailing/bookings/<%= encodeURIComponent(booking.id) %>" style="color: #ff986f; font-weight: bold;">Open booking</a>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div style="background: var(--bg-card); border: 1px solid #333; border-radius: 8px; padding: 40px; text-align: center;">
                <p style="color: var(--text-muted); font-size: 1.1rem; margin: 0;">No detailing bookings yet.</p>
            </div>
        <% } %>
    </div>
</main>

<%- include('../partials/footer') %>
