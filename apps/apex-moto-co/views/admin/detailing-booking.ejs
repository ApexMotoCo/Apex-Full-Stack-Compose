<%- include('../partials/header') %>

<main class="container" style="padding: 30px 0;">
    <div style="display: flex; justify-content: space-between; gap: 15px; align-items: center; margin-bottom: 25px;">
        <div>
            <p style="color: var(--text-muted); margin: 0 0 6px;">Detailing booking #<%= booking.id %></p>
            <h1 style="color: var(--primary); margin: 0;"><%= booking.name || 'Customer booking' %></h1>
        </div>
        <a href="/admin/detailing/bookings" class="btn btn-warning">Back to bookings</a>
    </div>

    <section style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; padding: 24px; margin-bottom: 24px;">
        <h2 style="margin: 0 0 18px; color: var(--primary);">Booking details</h2>
        <dl class="booking-details">
            <div><dt>Status</dt><dd><%= (booking.status || 'pending').replace(/_/g, ' ') %></dd></div>
            <div><dt>Service</dt><dd><%= booking.service_type || 'Service not specified' %></dd></div>
            <div><dt>Vehicle type</dt><dd><%= booking.vehicle_type || 'Not specified' %></dd></div>
            <div><dt>Appointment</dt><dd><%= booking.booking_date || 'Date not specified' %><% if (booking.booking_time) { %> at <%= booking.booking_time %><% } %></dd></div>
            <div><dt>Customer</dt><dd><%= booking.name || 'Not specified' %></dd></div>
            <div><dt>Email</dt><dd><% if (booking.email) { %><a href="mailto:<%= booking.email %>"><%= booking.email %></a><% } else { %>Not provided<% } %></dd></div>
            <div><dt>Phone</dt><dd><% if (booking.phone) { %><a href="tel:<%= booking.phone %>"><%= booking.phone %></a><% } else { %>Not provided<% } %></dd></div>
            <div><dt>Submitted</dt><dd><%= booking.created_at || 'Not available' %></dd></div>
        </dl>
        <div style="margin-top: 20px;">
            <h3 style="margin: 0 0 8px;">Customer notes</h3>
            <p style="white-space: pre-wrap; margin: 0; color: var(--text-muted);"><%= booking.notes || 'No additional notes.' %></p>
        </div>
    </section>

    <section style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; padding: 24px;">
        <h2 style="margin: 0 0 18px; color: var(--primary);">Vehicle photos (<%= photos.length %>)</h2>
        <% if (photos.length) { %>
            <div class="booking-photos">
                <% photos.forEach((photo, index) => { %>
                    <a href="/uploads/detailing-jobs/<%= encodeURIComponent(photo.filename) %>" target="_blank" rel="noopener noreferrer">
                        <img src="/uploads/detailing-jobs/<%= encodeURIComponent(photo.filename) %>" alt="<%= photo.original_name || `Vehicle photo ${index + 1}` %>">
                        <span><%= photo.original_name || `Photo ${index + 1}` %></span>
                    </a>
                <% }); %>
            </div>
        <% } else { %>
            <p style="color: var(--text-muted); margin: 0;">No photos are attached to this booking.</p>
        <% } %>
    </section>
</main>

<style>
.booking-details { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px; margin: 0; }
.booking-details dt { color: var(--text-muted); font-size: 0.9rem; margin-bottom: 4px; }
.booking-details dd { margin: 0; font-weight: 600; overflow-wrap: anywhere; }
.booking-details a, .booking-photos a { color: #ff986f; }
.booking-photos { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; }
.booking-photos a { display: grid; gap: 8px; text-decoration: none; }
.booking-photos img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 6px; background: #111; }
</style>

<%- include('../partials/footer') %>
