<%- include('../partials/header') %>

<main class="container" style="padding: 30px 0;">
    <div style="display: flex; justify-content: space-between; gap: 15px; align-items: center; margin-bottom: 25px;">
        <h1 style="color: var(--primary); margin: 0;">Contact Messages</h1>
        <a href="/admin" class="btn btn-warning">Back to Dashboard</a>
    </div>
    <div style="overflow-x: auto;">
        <table>
            <thead><tr><th>Date</th><th>From</th><th>Department</th><th>Subject</th><th>Email</th><th>Status</th></tr></thead>
            <tbody>
                <% messages.forEach((message) => { %>
                    <tr>
                        <td><%= new Date(message.created_at).toLocaleString('en-GB', { timeZone: 'Europe/London' }) %></td>
                        <td><%= message.name %></td>
                        <td><%= message.department || 'General' %></td>
                        <td><%= message.subject %></td>
                        <td><a href="mailto:<%= message.email %>"><%= message.email %></a></td>
                        <td><%= message.email_status || 'pending' %></td>
                    </tr>
                    <tr><td colspan="6" style="color: var(--text-muted); white-space: pre-wrap;"><%= message.message %></td></tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</main>

<style>
table { width: 100%; border-collapse: collapse; }
th, td { padding: 12px; border-bottom: 1px solid var(--border-color); text-align: left; }
th { color: var(--primary); text-transform: uppercase; }
</style>

<%- include('../partials/footer') %>
