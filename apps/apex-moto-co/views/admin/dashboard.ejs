<%- include('../partials/header') %>

<div class="container">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; border-bottom: 1px solid var(--border-color); padding-bottom: 20px;">
        <h1 style="margin: 0; color: var(--primary); text-transform: uppercase; font-size: 2em; letter-spacing: 1px;">⚙️ Admin Dashboard</h1>
        <div style="display: flex; gap: 10px;">
            <a href="/" class="btn btn-primary" style="text-decoration: none; font-size: 0.9em;">View Site</a>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 25px; margin-bottom: 50px;">
        <div class="card">
            <div class="card-content" style="text-align: center;">
                <div style="font-size: 2.5em; color: var(--primary); font-weight: bold; margin-bottom: 10px;"><%= stats.bookings %></div>
                <div style="color: var(--text-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 1px;">Detailing Bookings</div>
            </div>
        </div>

        <div class="card">
            <div class="card-content" style="text-align: center;">
                <div style="font-size: 2.5em; color: var(--primary); font-weight: bold; margin-bottom: 10px;"><%= stats.announcements %></div>
                <div style="color: var(--text-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 1px;">Announcements</div>
            </div>
        </div>

        <div class="card">
            <div class="card-content" style="text-align: center;">
                <div style="font-size: 2.5em; color: var(--primary); font-weight: bold; margin-bottom: 10px;"><%= stats.items %></div>
                <div style="color: var(--text-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 1px;">Store Items</div>
            </div>
        </div>

        <div class="card">
            <div class="card-content" style="text-align: center;">
                <div style="font-size: 2.5em; color: var(--primary); font-weight: bold; margin-bottom: 10px;"><%= stats.users %></div>
                <div style="color: var(--text-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 1px;">Total Users</div>
            </div>
        </div>

        <div class="card">
            <div class="card-content" style="text-align: center;">
                <div style="font-size: 2.5em; color: var(--warning); font-weight: bold; margin-bottom: 10px;">£<%= stats.orders %></div>
                <div style="color: var(--text-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 1px;">Completed Orders</div>
            </div>
        </div>
    </div>

    <div class="admin-panel" style="max-width: 900px;">
        <h3 style="margin-top: 0; color: var(--text-main); text-transform: uppercase; border-bottom: 2px solid var(--border-color); padding-bottom: 15px;">🎯 Admin Tools</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px;">
            <a href="/admin/settings" class="btn btn-primary" style="text-decoration: none; text-align: center; background: linear-gradient(135deg, #ff5500, #ff7722); font-weight: 800;">⚙️ SITE SETTINGS</a>
            <a href="/admin/detailing/bookings" class="btn btn-primary" style="text-decoration: none; text-align: center;">🔧 Detailing Bookings</a>
            <a href="/admin/store" class="btn btn-primary" style="text-decoration: none; text-align: center;">🛍️ Store Items</a>
            <a href="/admin/services" class="btn btn-primary" style="text-decoration: none; text-align: center;">📋 Services</a>
            <a href="/admin/gallery" class="btn btn-primary" style="text-decoration: none; text-align: center;">🖼️ Portfolio Gallery</a>
            <a href="/admin/announcements" class="btn btn-primary" style="text-decoration: none; text-align: center;">📢 Announcements</a>
            <a href="/admin/users" class="btn btn-primary" style="text-decoration: none; text-align: center;">👥 Users</a>
            <a href="/admin/audit-logs" class="btn btn-primary" style="text-decoration: none; text-align: center; background: linear-gradient(135deg, #64748b, #475569); font-weight: 800;">🧾 Audit & Request Logs</a>
            <a href="/admin/contact-messages" class="btn btn-primary" style="text-decoration: none; text-align: center; background: linear-gradient(135deg, #0ea5e9, #0284c7); font-weight: 800;">✉️ Contact Messages</a>
            <a href="/admin/health" class="btn btn-primary" style="text-decoration: none; text-align: center; background: linear-gradient(135deg, #10b981, #059669); font-weight: 800;">🩺 System Health</a>
            <a href="/admin/enable-2fa" class="btn btn-primary" style="text-decoration: none; text-align: center; background: linear-gradient(135deg, #8b5cf6, #a855f7); font-weight: 800;">🔐 2FA Settings</a>
            <a href="/logout" class="btn btn-danger" style="text-decoration: none; text-align: center;">🚪 Logout</a>
        </div>
    </div>

    <div style="margin-top: 40px; padding: 20px; background: rgba(255, 85, 0, 0.05); border-left: 4px solid var(--primary); border-radius: 8px;">
        <h4 style="margin-top: 0; color: var(--primary); text-transform: uppercase; letter-spacing: 1px;">📋 Getting Started</h4>
        <ul style="margin: 10px 0; padding-left: 20px; color: var(--text-muted);">
            <li><strong>Site Settings:</strong> Edit branding, homepage content, footer, and legal pages</li>
            <li><strong>Store Items:</strong> Add and manage products for your e-commerce store</li>
            <li><strong>Services:</strong> Manage company services</li>
            <li><strong>Announcements:</strong> Post news and updates for your community</li>
            <li><strong>Users:</strong> Manage user accounts and permissions</li>
            <li><strong>2FA Settings:</strong> Enable and manage two-factor authentication</li>
        </ul>
    </div>
</div>

<%- include('../partials/footer') %>

