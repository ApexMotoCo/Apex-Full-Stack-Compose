<%- include('../partials/header') %>

<main class="container admin-dashboard">
    <section class="admin-page-heading">
        <div>
            <p class="admin-eyebrow">APEX MOTO &amp; CO · MANAGEMENT</p>
            <h1>Overview</h1>
            <p>Manage your bookings, content and customer communications.</p>
        </div>
        <a href="/" class="admin-button-secondary">View website <span aria-hidden="true">↗</span></a>
    </section>

    <section class="admin-metrics" aria-label="Business overview">
        <article class="admin-metric-card">
            <span class="admin-metric-label">Detailing bookings</span>
            <strong><%= stats.bookings %></strong>
            <a href="/admin/detailing/bookings">Manage bookings <span aria-hidden="true">→</span></a>
        </article>
        <article class="admin-metric-card">
            <span class="admin-metric-label">Announcements</span>
            <strong><%= stats.announcements %></strong>
            <a href="/admin/announcements">Manage content <span aria-hidden="true">→</span></a>
        </article>
        <article class="admin-metric-card">
            <span class="admin-metric-label">Registered users</span>
            <strong><%= stats.users %></strong>
            <a href="/admin/users">View users <span aria-hidden="true">→</span></a>
        </article>
        <article class="admin-metric-card admin-metric-card--revenue">
            <span class="admin-metric-label">Completed order value</span>
            <strong>£<%= stats.orders %></strong>
            <span class="admin-metric-footnote">All-time total</span>
        </article>
    </section>

    <section class="admin-tool-section" aria-labelledby="admin-operations-title">
        <div class="admin-section-heading">
            <div>
                <p class="admin-eyebrow">DAY-TO-DAY</p>
                <h2 id="admin-operations-title">Operations</h2>
            </div>
            <p>Keep customer services up to date.</p>
        </div>
        <div class="admin-tool-grid">
            <a href="/admin/detailing/bookings" class="admin-tool-card"><span class="admin-tool-index">01</span><strong>Detailing bookings</strong><span>Review and manage appointments</span></a>
            <a href="/admin/services" class="admin-tool-card"><span class="admin-tool-index">02</span><strong>Services</strong><span>Update your service catalogue</span></a>
            <a href="/admin/contact-messages" class="admin-tool-card"><span class="admin-tool-index">03</span><strong>Contact messages</strong><span>Respond to customer enquiries</span></a>
        </div>
    </section>

    <section class="admin-tool-section" aria-labelledby="admin-content-title">
        <div class="admin-section-heading">
            <div>
                <p class="admin-eyebrow">BRAND &amp; COMMUNICATIONS</p>
                <h2 id="admin-content-title">Content and marketing</h2>
            </div>
            <p>Publish updates and prepare customer campaigns.</p>
        </div>
        <div class="admin-tool-grid">
            <a href="/admin/announcements" class="admin-tool-card"><span class="admin-tool-index">01</span><strong>Announcements</strong><span>Share news with your community</span></a>
            <a href="/admin/gallery" class="admin-tool-card"><span class="admin-tool-index">02</span><strong>Portfolio gallery</strong><span>Manage featured work and images</span></a>
            <a href="/admin/marketing-assistant" class="admin-tool-card admin-tool-card--featured"><span class="admin-tool-index">03</span><strong>Marketing copilot</strong><span>Create campaign and social drafts</span></a>
            <a href="/admin/marketing-campaigns" class="admin-tool-card"><span class="admin-tool-index">04</span><strong>Email campaigns</strong><span>Review, schedule and send email</span></a>
            <a href="/admin/settings" class="admin-tool-card"><span class="admin-tool-index">05</span><strong>Site settings</strong><span>Update branding and page content</span></a>
        </div>
    </section>

    <section class="admin-tool-section" aria-labelledby="admin-system-title">
        <div class="admin-section-heading">
            <div>
                <p class="admin-eyebrow">ACCESS &amp; OVERSIGHT</p>
                <h2 id="admin-system-title">Administration</h2>
            </div>
            <p>Manage access and review system activity.</p>
        </div>
        <div class="admin-tool-grid">
            <a href="/admin/users" class="admin-tool-card"><span class="admin-tool-index">01</span><strong>Users and permissions</strong><span>Manage accounts and roles</span></a>
            <a href="/admin/audit-logs" class="admin-tool-card"><span class="admin-tool-index">02</span><strong>Audit and request logs</strong><span>Review administrative activity</span></a>
            <a href="/admin/health" class="admin-tool-card"><span class="admin-tool-index">03</span><strong>System health</strong><span>Check service status</span></a>
            <a href="/admin/enable-2fa" class="admin-tool-card"><span class="admin-tool-index">04</span><strong>Two-factor security</strong><span>Protect your admin account</span></a>
        </div>
    </section>
</main>

<%- include('../partials/footer') %>
