<%-include('partials/header')%>

<div class="container" style="max-width: 400px; margin: 50px auto;">
    <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 8px; padding: 40px; text-align: center;">
        <h1 style="margin-top: 0; color: var(--primary); font-size: 1.8em; margin-bottom: 10px;">🔑 Reset Password</h1>
        <p style="color: var(--text-muted); margin-bottom: 30px;">Enter your new password below.</p>

        <% if (error) { %>
            <div style="background: #ef4444; color: white; padding: 12px; border-radius: 4px; margin-bottom: 20px; font-size: 0.9em;">
                <%= error %>
            </div>
        <% } %>

        <% if (token) { %>
            <form method="POST" style="text-align: left;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="token" value="<%= token %>">

                <div style="margin-bottom: 20px;">
                    <label style="display: block; color: var(--text-main); font-weight: 600; margin-bottom: 8px;">New Password</label>
                    <input type="password" name="password" required placeholder="At least 8 characters" minlength="8" style="width: 100%; padding: 12px; background: rgba(255,255,255,0.05); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-main); font-size: 1em; box-sizing: border-box;">
                </div>

                <div style="margin-bottom: 20px;">
                    <label style="display: block; color: var(--text-main); font-weight: 600; margin-bottom: 8px;">Confirm Password</label>
                    <input type="password" name="confirmPassword" required placeholder="Re-enter your password" minlength="8" style="width: 100%; padding: 12px; background: rgba(255,255,255,0.05); border: 1px solid var(--border-color); border-radius: 4px; color: var(--text-main); font-size: 1em; box-sizing: border-box;">
                </div>

                <button type="submit" style="width: 100%; padding: 12px; background: linear-gradient(135deg, #10b981, #059669); color: white; border: none; border-radius: 4px; font-weight: bold; cursor: pointer; font-size: 1em; text-transform: uppercase; letter-spacing: 1px;">Reset Password</button>
            </form>
        <% } else { %>
            <div style="background: rgba(239,68,68,0.1); border: 1px solid #ef4444; padding: 20px; border-radius: 4px; color: var(--text-muted);">
                <p style="margin: 0;">This reset link is invalid or has expired.</p>
                <p style="margin: 10px 0 0 0;"><a href="/forgot-password" style="color: var(--primary); text-decoration: none; font-weight: 600;">Request a new reset link</a></p>
            </div>
        <% } %>

        <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--border-color);">
            <p style="color: var(--text-muted); font-size: 0.9em;">
                <a href="/login" style="color: var(--primary); text-decoration: none; font-weight: 600;">Back to Login</a>
            </p>
        </div>
    </div>
</div>

<%-include('partials/footer')%>
