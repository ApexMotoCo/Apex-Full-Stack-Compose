<%- include('../partials/header') %>

<style>
    .servicing-hero { border-bottom: 1px solid rgba(255, 85, 0, 0.35); }
    .servicing-card {
        position: relative;
        overflow: hidden;
        min-height: 245px;
    }
    .servicing-card::after {
        content: '';
        position: absolute;
        inset: 0;
        border-left: 3px solid transparent;
        pointer-events: none;
        transition: border-color 0.25s ease;
    }
    .servicing-card:hover::after { border-left-color: #ff5500; }
    .service-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        margin-bottom: 12px;
        border: 1px solid #ff5500;
        border-radius: 50%;
        color: #ff5500;
        font-size: 0.8rem;
        font-weight: 800;
    }
    @media (max-width: 600px) {
        .servicing-card { min-height: 0; }
    }
</style>

<main>
    <!-- Hero Section -->
    <section class="hero servicing-hero" aria-labelledby="servicing-title" style="min-height: 60vh; display: flex; align-items: center; justify-content: center; text-align: center; position: relative; overflow: hidden;">
        <div style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: radial-gradient(circle at center, rgba(255,85,0,0.15) 0%, rgba(5,5,5,0) 60%); z-index: -1;"></div>
        
        <div class="container">
            <h1 id="servicing-title" style="display: block !important; width: 100% !important; max-width: none !important; margin-left: auto !important; margin-right: auto !important; text-align: center !important; text-transform: uppercase; margin-bottom: 20px; text-shadow: 0 0 10px rgba(255,85,0,0.8), 0 0 20px rgba(255,85,0,0.5);">
                <span style="color: #fff;">Basic Motorcycle</span> <span style="color: #ff5500;">Servicing</span>
            </h1>
            
            <p style="font-size: 1.3rem; color: var(--text-muted); margin-bottom: 20px; max-width: 800px; margin-left: auto; margin-right: auto;">
                Professional routine maintenance to help keep your motorcycle running safely, reliably and at its best.
            </p>

            <p style="font-size: 1rem; color: #ff5500; margin-bottom: 30px; max-width: 800px; margin-left: auto; margin-right: auto; font-style: italic;">
                Detail. Service. Protect.
            </p>
            <p style="font-size: 0.95rem; color: var(--text-muted); max-width: 760px; margin: 0 auto;">
                Apex Moto Detailing provides basic motorcycle servicing and routine motorcycle maintenance.
                This is not a full motorcycle repair workshop; every job is subject to inspection and assessment before acceptance.
            </p>
        </div>
    </section>

    <!-- Services Grid -->
    <section class="py-5" aria-labelledby="servicing-offer-title">
        <div class="container">
            <h2 id="servicing-offer-title" style="text-align: center; color: #ff5500; text-transform: uppercase; letter-spacing: 1px; margin-bottom: 50px; font-size: 1.8rem;">Basic Motorcycle Servicing</h2>
            
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 25px; margin-bottom: 60px; text-align: center;">
                <!-- Oil & Filter -->
                <div class="servicing-card" style="background: var(--bg-card); border: 1px solid #333; border-radius: 8px; padding: 30px; text-align: center; transition: all 0.3s ease; cursor: pointer;"
                     onmouseover="this.style.borderColor='#ff5500'; this.style.boxShadow='0 10px 30px rgba(255,85,0,0.2)'; this.style.transform='translateY(-5px)'"
                     onmouseout="this.style.borderColor='#333'; this.style.boxShadow='none'; this.style.transform='translateY(0)'">
                    <span class="service-number">01</span><div style="font-size: 2.5rem; margin-bottom: 15px;" aria-hidden="true">🛢️</div>
                    <h3 style="color: #ff5500; margin-top: 0; margin-bottom: 10px; font-size: 1.2rem;">Engine Oil & Filter Changes</h3>
                    <p style="color: var(--text-muted); margin: 0; font-size: 0.95rem;">Keep your engine lubricated with quality oil and fresh filters.</p>
                </div>

                <!-- Air Filter -->
                <div class="servicing-card" style="background: var(--bg-card); border: 1px solid #333; border-radius: 8px; padding: 30px; text-align: center; transition: all 0.3s ease; cursor: pointer;"
