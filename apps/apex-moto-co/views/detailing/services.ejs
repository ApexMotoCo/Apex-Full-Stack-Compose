                    <span class="service-number">02</span><div style="font-size: 2.5rem; margin-bottom: 15px;" aria-hidden="true">💨</div>
                    <h3 style="color: #ff5500; margin-top: 0; margin-bottom: 10px; font-size: 1.2rem;">Air Filter Replacement</h3>
                    <p style="color: var(--text-muted); margin: 0; font-size: 0.95rem;">Ensure optimal engine breathing and performance.</p>
                </div>

                <!-- Spark Plugs -->
                <div class="servicing-card" style="background: var(--bg-card); border: 1px solid #333; border-radius: 8px; padding: 30px; text-align: center; transition: all 0.3s ease; cursor: pointer;"
