<%- include('../partials/header') %>

<style>
/* Utility classes used on this page (not defined in the site stylesheet) */
.detailing-page .py-5 { padding: 56px 0; }
.detailing-page .text-center { text-align: center; }
.detailing-page .mb-4 { margin-bottom: 24px; }
.detailing-page .mb-5 { margin-bottom: 32px; }
/* Sections handle their own spacing, so don't stack the container's 40px margin on top */
.detailing-page section .container { margin-top: 0; margin-bottom: 0; }
@media (max-width: 768px) { .detailing-page .py-5 { padding: 36px 0; } }
