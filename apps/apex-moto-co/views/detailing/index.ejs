<script>
function updateVehicleSections() {
    const type = document.getElementById('vehicle_type').value;
    const show = (id, on) => { document.getElementById(id).style.display = on ? 'block' : 'none'; };

    show('moto_treatments', type === 'Motorcycle');
    show('moto_additional_services', type === 'Motorcycle');
    show('car_treatments', type === 'Car');
    show('additional_services', type === 'Car');
    show('other_treatments', type === 'Other');
}

document.getElementById('vehicle_type').addEventListener('change', updateVehicleSections);

// Run on load and when returning via back/forward so the sections always match the dropdown
updateVehicleSections();
window.addEventListener('pageshow', updateVehicleSections);

// Don't allow booking dates in the past
(function () {
    const d = new Date();
    const today = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
    document.getElementById('booking_date').min = today;
})();

document.querySelectorAll('input[name="treatment"]').forEach((input) => {
    input.addEventListener('change', () => {
        document.getElementById('service_type').value = input.value;
    });
});

// Direct booking form submission
document.getElementById('bookingForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    
    const formData = new FormData(this);
    const data = Object.fromEntries(formData);
    // keep every ticked additional service (fromEntries only keeps the last one)
    data.additional_services = formData.getAll('additional_services').join(', ');
    
    try {
        const response = await fetch('/detailing/book', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        });
        
        if (response.ok) {
            alert('Booking request submitted! We will contact you soon.');
            this.reset();
        } else {
            const err = await response.json().catch(() => ({}));
            alert(err.error || 'Error submitting booking');
        }
    } catch (error) {
        console.error('Error:', error);
        alert('Error submitting booking');
    }
});
</script>

