    <footer class="site-footer">
        <div class="container site-footer-inner">
            <!-- Footer Links -->
            <div class="site-footer-links">
                <a href="/">Home</a>
                <a href="/store">Store</a>
                <a href="/detailing">Detailing</a>
                <a href="/events">Events</a>
                <a href="/announcements">Announcements</a>
                <a href="/contact">Contact</a>
                <a href="/about">About Us</a>
            </div>

            <% if (isPublicPage !== false) { %>
            <section class="newsletter-signup" id="newsletter" aria-labelledby="newsletter-heading">
                <h2 id="newsletter-heading">Get Apex Moto & Co updates</h2>
                <p>Be first to hear about new products, events and offers.</p>
                <% if (newsletterStatus === 'success') { %>
                    <p class="newsletter-status" role="status">Thanks for signing up. You can unsubscribe from any email.</p>
                <% } else if (newsletterStatus === 'error') { %>
                    <p class="newsletter-status newsletter-status--error" role="alert">Enter a valid email address and tick the consent box to sign up.</p>
                <% } %>
                <form class="newsletter-form" method="POST" action="/marketing/subscribe">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <label class="visually-hidden" for="newsletter-email">Email address</label>
                    <input id="newsletter-email" name="email" type="email" maxlength="254" autocomplete="email" placeholder="you@example.com" required>
                    <label class="newsletter-consent">
                        <input type="checkbox" name="marketing_consent" required>
                        <span>Yes, email me news, offers and marketing updates. I can unsubscribe at any time. See our <a href="/privacy">Privacy Policy</a>.</span>
                    </label>
                    <button class="btn btn-primary" type="submit">Sign me up</button>
                </form>
            </section>
            <% } %>

            <!-- Legal Links -->
            <div class="site-footer-legal">
                <a href="/privacy">Privacy Policy</a>
                <a href="/terms">Terms & Conditions</a>
                <a href="/cookies">Cookie Policy</a>
            </div>

            <!-- Company Info -->
            <div style="text-align: center; margin-top: 30px; padding-top: 20px; border-top: 1px solid rgba(255, 85, 0, 0.2); font-size: 0.85em; color: var(--text-muted); line-height: 1.6;">
                <p style="margin: 0 0 8px 0;"><strong style="color: var(--text-main);">Apex Moto & Co.</strong></p>
                <p style="margin: 0 0 8px 0;">Premium Motorcycle Lifestyle Hub</p>
                <p style="margin: 0;"><a href="/contact" style="color: #ff5500; text-decoration: none;">Get in Touch</a></p>
            </div>

            <!-- Copyright -->
            <p class="site-footer-copyright">© 2026 ApexMoto&Co. All rights reserved.</p>
            <p class="site-footer-tagline">Premium Motorcycle Lifestyle Hub <span>•</span> Detailing Services <span>•</span> Community Events</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
