<%- include('./partials/header') %>

<div class="hero" style="background: linear-gradient(135deg, #1a0a00 0%, #000000 100%); border-bottom: 1px solid var(--primary); box-shadow: inset 0 0 80px rgba(255, 85, 0, 0.1); color: var(--text-main); text-align: center; padding: 80px 20px;">
    <h1 style="margin: 0; font-size: 3em; font-weight: 900; text-transform: uppercase; letter-spacing: 2px; text-shadow: 0 2px 15px rgba(255, 85, 0, 0.4);">Our Services</h1>
    <p style="color: var(--warning); font-size: 1.2em; font-weight: 600; letter-spacing: 1px; margin-top: 10px;">Premium Motorcycle Care & Lifestyle Services</p>
</div>

<div class="container">
    <div style="margin: 60px 0;">
        
        <!-- Services Grid -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px; margin-bottom: 60px;">
            
            <!-- Detailing Service -->
            <div style="background: var(--bg-card); border: 2px solid #ff5500; border-radius: 8px; padding: 30px; text-align: center;">
                <h2 style="color: #ff5500; text-transform: uppercase; margin-top: 0; font-size: 1.5em;">🏍️ Detailing</h2>
                <p style="color: var(--text-muted); line-height: 1.8; margin: 20px 0;">
                    Professional motorcycle detailing services including deep cleaning, paint protection, and premium finishes to keep your ride looking showroom fresh.
                </p>
                <a href="/detailing" class="btn btn-primary" style="margin-top: 20px;">Learn More</a>
            </div>

            <!-- Servicing Service -->
            <div style="background: var(--bg-card); border: 2px solid #ff5500; border-radius: 8px; padding: 30px; text-align: center;">
                <h2 style="color: #ff5500; text-transform: uppercase; margin-top: 0; font-size: 1.5em;">🔧 Servicing</h2>
                <p style="color: var(--text-muted); line-height: 1.8; margin: 20px 0;">
                    Professional basic motorcycle servicing and routine maintenance to keep your motorcycle running safely, reliably and at its best.
                </p>
                <a href="/services" class="btn btn-primary" style="margin-top: 20px;">View Services</a>
            </div>

            <!-- Events Service -->
            <div style="background: var(--bg-card); border: 2px solid #ff5500; border-radius: 8px; padding: 30px; text-align: center;">
                <h2 style="color: #ff5500; text-transform: uppercase; margin-top: 0; font-size: 1.5em;">🎉 Events</h2>
                <p style="color: var(--text-muted); line-height: 1.8; margin: 20px 0;">
                    Community-driven motorcycle events, meet-ups, and exclusive gatherings for enthusiasts to connect, share experiences, and celebrate the lifestyle.
                </p>
                <a href="/events" class="btn btn-primary" style="margin-top: 20px;">View Events</a>
            </div>

            <!-- Store Service -->
            <div style="background: var(--bg-card); border: 2px solid #ff5500; border-radius: 8px; padding: 30px; text-align: center;">
                <h2 style="color: #ff5500; text-transform: uppercase; margin-top: 0; font-size: 1.5em;">🛍️ Store</h2>
                <p style="color: var(--text-muted); line-height: 1.8; margin: 20px 0;">
                    Curated selection of premium motorcycle gear, apparel, and accessories from top brands to enhance your riding experience.
                </p>
                <a href="/store" class="btn btn-primary" style="margin-top: 20px;">Shop Now</a>
            </div>

        </div>

        <!-- Services Description -->
        <div style="background: var(--bg-card); border: 2px solid var(--border-color); border-radius: 8px; padding: 40px; margin-bottom: 40px;">
            <h2 style="color: var(--primary); text-transform: uppercase; margin-top: 0; text-align: center;">Why Choose ApexMoto&Co?</h2>
            
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 30px; margin-top: 30px;">
                <div style="padding: 20px;">
                    <h3 style="color: #ff5500; font-size: 1.2em;">✓ Expert Team</h3>
                    <p style="color: var(--text-muted); line-height: 1.6;">Passionate motorcycle enthusiasts with years of experience in detailing, events, and community building.</p>
                </div>
                <div style="padding: 20px;">
                    <h3 style="color: #ff5500; font-size: 1.2em;">✓ Premium Quality</h3>
                    <p style="color: var(--text-muted); line-height: 1.6;">Only the best products, services, and experiences for our community members and customers.</p>
                </div>
                <div style="padding: 20px;">
                    <h3 style="color: #ff5500; font-size: 1.2em;">✓ Community Focused</h3>
                    <p style="color: var(--text-muted); line-height: 1.6;">Building a thriving community of motorcycle enthusiasts united by passion and authenticity.</p>
                </div>
            </div>
        </div>

        <!-- CTA -->
        <div style="text-align: center; background: linear-gradient(135deg, rgba(255, 85, 0, 0.1) 0%, rgba(255, 85, 0, 0.05) 100%); border: 2px solid #ff5500; border-radius: 8px; padding: 40px;">
            <h2 style="color: var(--primary); margin-top: 0;">Ready to Experience ApexMoto&Co?</h2>
            <p style="color: var(--text-muted); font-size: 1.1em; margin-bottom: 30px;">Get in touch with our team to learn more about our services or book a consultation.</p>
            <a href="/contact" class="btn btn-primary" style="padding: 15px 40px; font-size: 1.1em;">Contact Us Today</a>
        </div>

    </div>
</div>

<%- include('./partials/footer') %>
