<%- include('./partials/header') %>

<div class="container">
    <div class="admin-form-panel" style="max-width: 600px; margin: 0 auto;">
        <h2 style="margin-top: 0; text-transform: uppercase; text-align: center; color: var(--primary); letter-spacing: 1px;">📝 Contact Us</h2>
        
        <% if (locals.success) { %>
            <div class="alert alert-success"><%= success %></div>
        <% } %>
        <% if (locals.error) { %>
            <div class="alert alert-danger"><%= error %></div>
        <% } %>

        <form method="POST" style="margin-top: 30px;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div style="position: absolute; left: -10000px;" aria-hidden="true">
                <label for="website">Leave this field empty</label>
                <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
            </div>
            <label for="name">Your Name <span style="color: #ff5500;">*</span></label>
            <input type="text" id="name" name="name" placeholder="John Smith" required>

            <label for="email">Email Address <span style="color: #ff5500;">*</span></label>
            <input type="email" id="email" name="email" placeholder="john@example.com" required>

            <label for="department">Department / Service <span style="color: #ff5500;">*</span></label>
            <select id="department" name="department" style="width: 100%; padding: 12px; background-color: #111; color: #fff; border: 1px solid #444; border-radius: 8px; font-family: inherit; font-size: 1em; cursor: pointer;" required>
                <option value="">-- Select a Department --</option>
                <option value="General">General Inquiry</option>
                <option value="Shop">Shop / Store</option>
                <option value="Detailing">Detailing Services</option>
                <option value="Events">Events</option>
            </select>

            <label for="subject">Subject <span style="color: #ff5500;">*</span></label>
            <input type="text" id="subject" name="subject" placeholder="What's this about?" required>

            <label for="message">Message <span style="color: #ff5500;">*</span></label>
            <textarea id="message" name="message" placeholder="Tell us what you think..." rows="6" required></textarea>

            <div style="background: rgba(255, 85, 0, 0.1); padding: 15px; border-radius: 6px; margin-top: 20px; font-size: 0.85em; line-height: 1.6; color: var(--text-muted); border-left: 3px solid #ff5500;">
                <p style="margin: 0;"><strong style="color: #ff5500;">Data Protection:</strong> We collect your contact details to respond to your inquiry. Your data is protected under UK GDPR. <a href="/privacy" style="color: #ff5500; text-decoration: none;">Read our Privacy Policy</a>.</p>
            </div>

            <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 20px;">Send Message</button>
        </form>
    </div>
</div>

<%- include('./partials/footer') %>
